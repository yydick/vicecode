{
    "name": "yydick/vicecode",
    "type": "project",
    "version": "0.0.2",
    "description": "VSCode-style multi-panel terminal workspace (TUI) built with php-tui and Swoole.",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "php-tui/php-tui": "^0.2",
        "scrivo/highlight.php": "^9.18",
        "ext-swoole": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "tools/run_tests.sh"
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/composer/"
        }
    }
}
